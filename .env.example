# Copy this file to .env before running `make up`.
POSTGRES_DB=event_processing
POSTGRES_USER=event_processor
POSTGRES_PASSWORD=change-me-before-sharing
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Small pool for one dev Postgres instance; not sized for production concurrency.
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10

# A stable KRaft cluster ID. Do not change it while the kafka-data volume exists.
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk
